{
    "name": "plainrouter/sdk",
    "description": "Official PHP SDK for the Plainrouter Signals Conversion API",
    "type": "library",
    "keywords": ["plainrouter", "conversion api", "sdk", "openapi"],
    "homepage": "https://plainrouter.com",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Plainrouter",
            "homepage": "https://plainrouter.com"
        }
    ],
    "support": {
        "issues": "https://github.com/plainrouter/sdk/issues",
        "source": "https://github.com/plainrouter/sdk/tree/main/packages/php"
    },
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Plainrouter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Plainrouter\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
